{
  "manifest_version": 3,
  "name": "Mouse Bridge",
  "description": "Extends Kimi WebBridge with real OS-level mouse control: element location, desktop coordinate mapping (DPI/zoom aware), human-like cursor movement, clicks and drag. Toolbar panel: daemon status, live page coordinates, move-to-css-coordinate.",
  "version": "1.1.1",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mouse Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
